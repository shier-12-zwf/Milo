{
  app: {
    products: [
      {
        name: 'default',
        compatibleSdkVersion: '6.1.1(24)',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
        },
      },
      {
        name: 'release',
        compatibleSdkVersion: '6.1.1(24)',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
        },
      },
    ],
    buildModeSet: [
      {
        name: 'debug',
      },
      {
        name: 'release',
      },
    ],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
        targets: [
          {
            name: 'default',
            applyToProducts: [
              'default',
              'release',
            ],
          },
        ],
    },
  ],
}
